/* ── Base ── */
QMainWindow, QWidget {
    background-color: #1a1a1a;
    color: #d4d4d4;
    font-size: 10pt;
}

/* ── Labels ── */
QLabel {
    color: #d4d4d4;
    background: transparent;
}
QLabel#hint {
    color: #888888;
    font-size: 9pt;
}
QLabel#logo {
    color: #00c853;
    font-size: 14pt;
    font-weight: bold;
}
QLabel#projectName {
    color: #a0a0a0;
    font-size: 9pt;
}

/* ── Buttons ── */
QPushButton {
    background-color: #2d2d2d;
    color: #d4d4d4;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton:hover {
    background-color: #3a3a3a;
    border: 1px solid #00c853;
}
QPushButton:pressed {
    background-color: #00c853;
    color: #1a1a1a;
}
QPushButton:disabled {
    background-color: #222222;
    color: #555555;
    border: 1px solid #2a2a2a;
}
QPushButton:checked {
    background-color: #1a3a2a;
    border: 1px solid #00c853;
    color: #00c853;
}

/* ── Sidebar ── */
QFrame#sidebar {
    background-color: #121212;
    border-right: 1px solid #2a2a2a;
}

/* ── Input Fields ── */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #252525;
    color: #d4d4d4;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 4px 8px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00c853;
}

/* ── Combo Box ── */
QComboBox {
    background-color: #252525;
    color: #d4d4d4;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}
QComboBox:hover {
    border: 1px solid #00c853;
}
QComboBox::drop-down {
    background-color: #2d2d2d;
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #00c853;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #252525;
    color: #d4d4d4;
    border: 1px solid #3a3a3a;
    selection-background-color: #1a3a2a;
    selection-color: #00c853;
    outline: none;
}

/* ── Group Box ── */
QGroupBox {
    background-color: #1e1e1e;
    border: 1px solid #2d2d2d;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #00c853;
}

/* ── Tables ── */
QTableWidget, QTreeWidget {
    background-color: #1a1a1a;
    color: #d4d4d4;
    border: 1px solid #2d2d2d;
    border-radius: 4px;
    gridline-color: #2a2a2a;
    selection-background-color: #1a3a2a;
    selection-color: #00c853;
    outline: none;
}
QTableWidget::item, QTreeWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #242424;
}
QTableWidget::item:alternate, QTreeWidget::item:alternate {
    background-color: #1e1e1e;
}
QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #1a3a2a;
    color: #00c853;
}
QHeaderView::section {
    background-color: #252525;
    color: #a0a0a0;
    border: none;
    border-bottom: 1px solid #3a3a3a;
    padding: 6px 8px;
    font-weight: bold;
}

/* ── Tabs ── */
QTabWidget::pane {
    background-color: #1a1a1a;
    border: 1px solid #2d2d2d;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #222222;
    color: #888888;
    border: none;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: #1a1a1a;
    color: #00c853;
    border-bottom: 2px solid #00c853;
}
QTabBar::tab:hover:!selected {
    background-color: #2a2a2a;
    color: #d4d4d4;
}

/* ── Scroll Bars ── */
QScrollBar:vertical {
    background-color: #1a1a1a;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #3a3a3a;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #00c853;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: #1a1a1a;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #3a3a3a;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #00c853;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #2d2d2d;
    width: 2px;
}

/* ── Scroll Area ── */
QScrollArea {
    border: none;
    background: transparent;
}

/* ── Status Bar ── */
QStatusBar {
    background-color: #121212;
    color: #888888;
    border-top: 1px solid #2a2a2a;
}

/* ── Frames / Cards ── */
QFrame[frameShape="5"] {
    /* StyledPanel */
    background-color: #1e1e1e;
    border: 1px solid #2d2d2d;
    border-radius: 8px;
}

/* ── Dialogs ── */
QDialog {
    background-color: #1a1a1a;
}

/* ── Tool Tips ── */
QToolTip {
    background-color: #252525;
    color: #d4d4d4;
    border: 1px solid #00c853;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ── Render Log ── */
QTextEdit#renderLog {
    background-color: #0d0d0d;
    color: #b0b0b0;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 9pt;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #1a3a2a;
    selection-color: #00c853;
}
